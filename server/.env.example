HOST=127.0.0.1
PORT=3001
DB_PATH=./data/xpsync.db
# Required: generate with node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-at-least-32-random-characters
# Required for the one-time admin setup. Choose a random value, then remove after setup.
SETUP_TOKEN=replace-with-a-random-one-time-setup-token
# Comma-separated allowed browser origins for plugin connections; * permits any origin.
# Requests still need a project API key. Admin REST is same-origin only.
CLIENT_ORIGINS=*
